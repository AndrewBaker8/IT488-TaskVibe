<Window x:Class="TaskVibe.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskVibe.UI"
        mc:Ignorable="d"
        Title="TaskVibe Management System" Height="500" Width="850">
    <Grid>
        <!-- Define our two main sections: Left for Form, Right for Task List -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <!-- Fixed width for inputs -->
            <ColumnDefinition Width="*"/>
            <!-- Takes up the rest of the screen -->
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: Task Entry Form -->
        <StackPanel Grid.Column="0" Margin="15">
            <TextBlock Text="Task Management" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <!-- Task Title -->
            <TextBlock Text="Task Title" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtTaskTitle" Height="25" Margin="0,0,0,15"/>

            <!-- Due Date -->
            <TextBlock Text="Due Date" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <DatePicker x:Name="DpDueDate" Height="25" Margin="0,0,0,15"/>

            <!-- Status Selection -->
            <TextBlock Text="Initial Status" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbStatus" Height="25" Margin="0,0,0,20" SelectedIndex="0">
                <ComboBoxItem Content="Not Started"/>
                <ComboBoxItem Content="In Process"/>
                <ComboBoxItem Content="Completed"/>
            </ComboBox>

            <!-- 1. CREATE MODE PANEL (Visible by Default) -->
            <StackPanel x:Name="PnlCreateMode" Visibility="Visible" Margin="0,5,0,0">
                <Button x:Name="BtnCreateTask" 
                        Content="Add Task" 
                        Height="35" 
                        Background="#007ACC" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        Click="BtnCreateTask_Click"/>
            </StackPanel>

            <!-- 2. EDIT/DELETE MODE PANEL (Hidden by Default) -->
            <StackPanel x:Name="PnlEditMode" Visibility="Collapsed" Margin="0,5,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnUpdateTask" 
                            Grid.Column="0" 
                            Content="Update" 
                            Height="35" 
                            Margin="0,0,3,0" 
                            Click="BtnUpdateTask_Click"/>

                    <Button x:Name="BtnDeleteTask" 
                            Grid.Column="1" 
                            Content="Delete" 
                            Height="35" 
                            Margin="2,0,2,0" 
                            Background="#FFF0F0" 
                            Foreground="#C00000" 
                            FontWeight="SemiBold" 
                            Click="BtnDeleteTask_Click"/>

                    <Button x:Name="BtnCancelEdit" 
                            Grid.Column="2" 
                            Content="Cancel" 
                            Height="35" 
                            Margin="3,0,0,0" 
                            Click="BtnCancelEdit_Click"/>
                </Grid>
            </StackPanel>

            <Separator Margin="0,20,0,15"/>

            <!-- Dev Tools: Keep your test button safe right here at the bottom -->
            <TextBlock Text="Developer Utilities" FontSize="11" Foreground="Gray" Margin="0,0,0,5"/>
            <Button x:Name="BtnTestConnection" Content="Test DB Connection" Height="30" Click="TestConnection_Click"/>
        </StackPanel>

        <!-- RIGHT PANEL: Main Task Dashboard Grid -->
        <Grid Grid.Column="1" Margin="15">
            <DataGrid x:Name="DgTasks" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single"
                      SelectionChanged="DgTasks_SelectionChanged"
                      Grid.Row="1" Margin="0,10,0,0">
                <DataGrid.Columns>
                    <!-- Standard Text Columns for Title & Due Date -->
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=\{0:MM/dd/yyyy\}}" Width="120" />

                    <!-- Custom Badged Column for Status -->
                    <DataGridTemplateColumn Header="Status" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="StatusBadge"
                                        CornerRadius="12"
                                        Padding="8,3"
                                        Width="95"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtStatus"
                                               Text="{Binding Status}"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Stretch" />
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- 1. NOT STARTED (Gray / Slate) -->
                                    <DataTrigger Binding="{Binding Status}" Value="Not Started">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#E2E8F0" />
                                        <Setter TargetName="TxtStatus" Property="Foreground" Value="#475569" />
                                    </DataTrigger>

                                    <!-- 2. IN PROGRESS (Blue) -->
                                    <DataTrigger Binding="{Binding Status}" Value="In Process">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#DBEAFE" />
                                        <Setter TargetName="TxtStatus" Property="Foreground" Value="#1E40AF" />
                                    </DataTrigger>

                                    <!-- 3. COMPLETED (Green) -->
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#DCFCE7" />
                                        <Setter TargetName="TxtStatus" Property="Foreground" Value="#15803D" />
                                    </DataTrigger>

                                    <!-- 4. LATE (Red / Warning) -->
                                    <DataTrigger Binding="{Binding Status}" Value="Late">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#FEE2E2" />
                                        <Setter TargetName="TxtStatus" Property="Foreground" Value="#B91C1C" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>